      ],
      "ingredients": [
        { "name": "Riso", "qty": "250 g", "note": "", "tags": [] },
        { "name": "Zucca", "qty": "300 g", "note": "", "tags": [] },
        { "name": "Grattugiato", "qty": "100 g", "note": "", "tags": [] },
        { "name": "Brodo", "qty": "1 l", "note": "", "tags": [] },
        { "name": "Cipolla", "qty": "1", "note": "", "tags": [] },
        { "name": "Burro", "qty": "50 g", "note": "", "tags": ["Opzionale"] },
        { "name": "Vino bianco", "qty": "100 g", "note": "", "tags": ["opzionale"] }
      ],
      "procedure": "Trita la cipolla e falla soffriggere, poi aggiungi la zucca a cubetti. Quando la zucca è morbida, unisci il riso e fallo tostare. Sfuma con il vino bianco, aggiungi il Brodo e fai cuocere per circa 20 minuti. Infine, manteca con il burro e il formaggio grattugiato.",
      "enjoy": "💙💜",
      "glossary": [
        {
          "term": "Brodo",
          "def": "Se non vuoi usare il dado, prepara il brodo vegetale con acqua e spezie: aglio, cipolla, curry, pepe, paprika, erba cipollina. Oppure usa del brodo già pronto."
        }
      ],
