        { "label": "Categoria", "value": "Smoothie", "isCat": true }
      ],
      "ingredients": [
        { "name": "Acqua", "qty": "125 ml", "note": "Sostituibile con ghiaccio 🧊🧊🧊", "tags": [] },
        { "name": "Limenta", "qty": "1 cubetto", "note": "", "tags": ["opzionale"] },
        { "name": "Mela", "qty": "1", "note": "", "tags": [] },
        { "name": "Arance", "qty": "2", "note": "", "tags": [] },
        { "name": "Kiwi", "qty": "1", "note": "", "tags": [] },
        { "name": "Uva", "qty": "250 g", "note": "", "tags": [] }
      ],
      "procedure": "Versa l’acqua nel frullatore — se preferisci usare il ghiaccio al suo posto, tienilo da parte e aggiungilo solo alla fine. Unisci la mela, le arance, il kiwi, l’uva e il cubetto di Limenta. Seleziona la modalità <strong>Smoothie&nbsp;→&nbsp;Smooth</strong> e avvia. Servi immediatamente.",
      "enjoy": "💙💜",
      "glossary": [
        {
          "term": "Limenta",
          "def": "Un cubetto aromatico ottenuto frullando insieme succo e scorza di lime con foglie di menta fresca, quindi congelando il composto in stampi da ghiaccio. Si conserva in freezer per mesi e si aggiunge direttamente durante la frullatura, dove si scioglie rilasciando un aroma fresco e agrumato. Conviene prepararne una dose abbondante in anticipo."
        }
      ],
      "tips": []
