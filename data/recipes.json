        { "label": "Categoria", "value": "Altro", "isCat": true }
      ],
      "ingredients": [
        { "name": "Acqua", "qty": "375 g", "note": "A temperatura ambiente", "tags": [] },
        { "name": "Farina 00", "qty": "650 g", "note": "", "tags": [] },
        { "name": "Lievito in polvere", "qty": "7 g", "note": "", "tags": [] },
        { "name": "Olio d’oliva", "qty": "25 g", "note": "", "tags": [] },
        { "name": "Strutto", "qty": "110 g", "note": "", "tags": [] },
        { "name": "Sale", "qty": "15 g", "note": "", "tags": [] },
        { "name": "Pepe", "qty": "4 g", "note": "", "tags": [] },
        { "name": "Zucchero", "qty": "5 g", "note": "", "tags": [] },
        { "name": "Provolone dolce", "qty": "140 g", "note": "", "tags": [] },
        { "name": "Pecorino / Asiago", "qty": "140 g", "note": "", "tags": [] },
        { "name": "Salame", "qty": "230 g", "note": "", "tags": [] },
        { "name": "Uova", "qty": "6", "note": "", "tags": [] }
      ],
      "procedure": "Aggiungi il lievito all’acqua a temperatura ambiente e mescola poi olio, metà strutto e amalgama il tutto.<br>Aggiungi la farina setacciata poco alla volta fino a ottenere una pastella alla quale aggiungi sale e pepe.<br>Aggiungi l’altra metà della farina e dello strutto e impasta almeno per 10 minuti.<br>Fai crescere l’impasto coperto per qualche ora.<br>Taglia tutto il ripieno a cubetti, stendi l’impasto a forma rettangolare e metti gli ingredienti.<br>Chiudi formando una girella, metti nella teglia leggermente struttata e fai crescere per almeno 1 ora.<br>Cuoci a forno statico a 170° sul ripiano più basso per circa 65 minuti.",
      "enjoy": "💙💜",
      "glossary": [],
      "tips": []
